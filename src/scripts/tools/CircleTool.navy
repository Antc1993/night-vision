// Navy ~ 0.2-lite
// <ds>Drawing circles [Center + Radius]</ds>

[OVERLAY name = CircleTool, ctx = Canvas, version = 1.0.0]

let timeId = null
let mouseX = 0
let circles = {} // Circle objects stored by uuid
let startDrawTool = false

init() {
    // Restore circles from dataExt
    for (var c of $core.dataExt.circles || []) {
        circles[c.uuid] = new $lib.Circle($core, c, c.isDrawing || false)
        circles[c.uuid].onSelect = circleSelected
        if (c.isDrawing) {
            circles[c.uuid].selected = true
        }
    }

    const handleToolCircle = event => {
        startDrawTool = true
    }
    $events.on($core.uuid + ':tool-circle', handleToolCircle)
    if ($core.dataExt && $core.dataExt.uuid) {
        $events.on($core.dataExt.uuid + ':tool-circle', handleToolCircle)
    }

    $events.on($core.uuid + ':tool-started', activeUuid => {
        if (activeUuid !== $core.uuid) {
            startDrawTool = false
        }
    })

    $events.on($core.uuid + ':delete-tool', uuid => {
        if (circles[uuid]) removeCircle(uuid)
    })

    $events.on('delete-all-tools', () => {
        for (var uuid in circles) {
            delete circles[uuid]
        }
        $core.dataExt.circles = []
        $events.emit('update-layout')
        $events.emit('selection-event', null)
    })

    $events.on($core.uuid + ':selection-event', data => {
        if (data && data.overlayUuid !== $core.uuid) {
            let changed = false
            for (var uuid in circles) {
                if (circles[uuid].selected) {
                    circles[uuid].selected = false
                    changed = true
                }
            }
            if (changed) $events.emit('update-layout')
        }
    })

    $events.on($core.uuid + ':update-settings', data => {
        const { uuid, settings, p1, p2, text } = data
        if (circles[uuid]) {
            if (settings) {
                circles[uuid].data.settings = Object.assign(circles[uuid].data.settings || {}, settings)
            }
            if (text !== undefined) {
                circles[uuid].data.text = text
                if (circles[uuid].data.settings) circles[uuid].data.settings.text = text
            }
            if (p1 && circles[uuid].pins[0]) {
                circles[uuid].data.p1 = p1
                circles[uuid].pins[0].t = p1[0]
                circles[uuid].pins[0].y$ = p1[1]
            }
            if (p2 && circles[uuid].pins[1]) {
                circles[uuid].data.p2 = p2
                circles[uuid].pins[1].t = p2[0]
                circles[uuid].pins[1].y$ = p2[1]
            }
            const d = $core.dataExt.circles.find(x => x.uuid === uuid)
            if (d) {
                if (settings) d.settings = Object.assign(d.settings || {}, settings)
                if (text !== undefined) {
                    d.text = text
                    if (d.settings) d.settings.text = text
                }
                if (p1) d.p1 = p1
                if (p2) d.p2 = p2
            }
            $events.emit('update-layout')
        }
    })
}

draw(ctx) {
    for (var c of Object.values(circles)) {
        c.draw(ctx)
    }
}

newCircle() {
    if (!$core.dataExt.circles) {
        $core.dataExt.circles = []
    }

    const cursor = $core.cursor || {}
    const mouse = $core.mouse || {}
    const layout = $core.layout

    const cx = cursor.x !== undefined ? cursor.x : (mouse.x !== undefined ? mouse.x : 0)
    const cy = cursor.y !== undefined ? cursor.y : (mouse.y !== undefined ? mouse.y : 0)

    const x2tFn = layout ? (layout.x2time || layout.x2t) : null
    let t = (cursor.time != null && !isNaN(cursor.time)) ? cursor.time : cursor.ti
    if ((t == null || isNaN(t)) && x2tFn) t = x2tFn.call(layout, cx)
    let $ = layout ? layout.y2value(cy) : 0
    let uuid = $lib.Utils.uuid3()

    let c = {
        type: 'circle',
        p1: [t, $],
        p2: [t, $],
        uuid: uuid,
        isDrawing: true
    }

    $core.dataExt.circles.push(c)
    circles[uuid] = new $lib.Circle($core, c, true)
    circles[uuid].onSelect = circleSelected
    circles[uuid].selected = false

    $events.emit('tool-started', $core.uuid)
    $events.emit('scroll-lock', true)
    $events.emit('hub:set-drawing-in-progress', true)
    $events.emit('update-layout')
    startDrawTool = false
    if (event) event.__toolCaptured = true
}

circleSelected($uuid, openSettings = false) {
    let selectedCircle = null
    for (var uuid in circles) {
        circles[uuid].selected = uuid === $uuid
        if (circles[uuid].selected) selectedCircle = circles[uuid]
    }
    $events.emit('update-layout')

    if (selectedCircle) {
        $events.emit('selection-event', {
            uuid: $uuid,
            overlayUuid: $core.uuid,
            type: 'circle',
            settings: selectedCircle.data.settings || {},
            data: selectedCircle.data,
            x: $core.mouse ? $core.mouse.x : 0,
            y: $core.mouse ? $core.mouse.y : 0,
            gridOffset: $core.layout.sbMax[0],
            paneOffset: $core.layout.offset,
            openSettings: openSettings
        })
    } else {
        $events.emit('selection-event', null)
    }
}

removeCircle(uuid) {
    delete circles[uuid]
    if ($core.dataExt.circles) {
        $core.dataExt.circles = $core.dataExt.circles.filter(x => x.uuid !== uuid)
    }
    $events.emit('update-layout')
}

propagate(name, data) {
    const list = (name === 'mousedown' || name === 'click') ? Object.values(circles).slice().reverse() : Object.values(circles)
    for (var c of list) {
        c[name](data)
    }
}

mousedown(event) {
    if (startDrawTool) {
        newCircle(event)
        if (event) event.__toolCaptured = true
        return
    }

    const drawingCircle = Object.values(circles).find(x => x.isDrawing || x.pins.some(p => p.state === 'tracking'))
    if (drawingCircle) {
        drawingCircle.mousedown(event)
        if (event) event.__toolCaptured = true
        return
    }

    if ($core.hub?.isDrawingMode && $core.hub.isDrawingMode()) {
        return
    }

    if (event && (event.__toolCaptured || $lib.Utils.defaultPrevented(event))) {
        return
    }

    if (event && event.detail === 2) {
        for (var c of Object.values(circles).slice().reverse()) {
            if (c.collision() || (c.pins && c.pins.some(p => p.hover()))) {
                circleSelected(c.data.uuid, true)
                event.__toolCaptured = true
                return
            }
        }
    }

    mouseX = $core.mouse ? $core.mouse.x : 0

    let hit = false
    for (var c of Object.values(circles).slice().reverse()) {
        if (c.collision() || (c.pins && c.pins.some(p => p.hover()))) {
            hit = true
            break
        }
    }

    if (!hit) {
        const hadSelected = Object.values(circles).some(x => x.selected)
        if (hadSelected) {
            circleSelected(null)
        }
    }

    $events.emit('update-layout')
    propagate('mousedown', event)
}

mouseup(event) {
    propagate('mouseup', event)
}

mousemove(event) {
    propagate('mousemove', event)
}

dblclick(event) {
    if ($core.hub?.isDrawingMode && $core.hub.isDrawingMode()) {
        return
    }
    propagate('dblclick', event)
}

keydown(event) {
    if (event.key === 'Delete' || event.key === 'Backspace') {
        const activeUuid = Object.keys(circles).find(u => circles[u].selected)
        if (activeUuid) {
            removeCircle(activeUuid)
            $events.emit('selection-event', null)
        }
    }
    if (event.key === 'Escape') {
        const drawingCircle = Object.values(circles).find(x => x.isDrawing)
        if (drawingCircle) {
            removeCircle(drawingCircle.data.uuid)
            $events.emit('scroll-lock', false)
            $events.emit('hub:set-drawing-in-progress', false)
            $events.emit('hub:set-drawing-tool', null)
        }
        startDrawTool = false
        $events.emit('update-layout')
    }
}
