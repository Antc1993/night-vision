// Navy ~ 0.2-lite
// <ds>Drawing lines [Tap + Hold]</ds>

[OVERLAY name = LineTool, ctx = Canvas, verion = 1.0.0]

let timeId = null
let mouseX = 0
let lines = {} // Line objects stored by uuid
let startDrawTool = false
let type = ''

init() {

    for (var line of $core.dataExt.lines || []) {
        console.log(line)
        lines[line.uuid] = new $lib.TrendLine($core, line)
        lines[line.uuid].onSelect = lineSelected
    }

    const handleToolLine = event => {
        type = event || 'segment'
        startDrawTool = true
    }
    $events.on($core.uuid + ':tool-line', handleToolLine)
    if ($core.dataExt && $core.dataExt.uuid) {
        $events.on($core.dataExt.uuid + ':tool-line', handleToolLine)
    }

    $events.on($core.uuid + ':tool-started', activeUuid => {
        if (activeUuid !== $core.uuid) {
            startDrawTool = false
        }
    })

    $events.on($core.uuid + ':delete-tool', uuid => {
        if (lines[uuid]) removeLine(uuid)
    })

    $events.on('delete-all-tools', () => {
        for (var uuid in lines) {
            delete lines[uuid]
        }
        $core.dataExt.lines = []
        $events.emit('update-layout')
        $events.emit('selection-event', null)
    })

    $events.on($core.uuid + ':selection-event', data => {
        if (data && data.overlayUuid !== $core.uuid) {
            let changed = false
            for (var uuid in lines) {
                if (lines[uuid].selected) {
                    lines[uuid].selected = false
                    changed = true
                }
            }
            if (changed) $events.emit('update-layout')
        }
    })

    $events.on($core.uuid + ':update-settings', data => {
        const { uuid, settings, p1, p2, text } = data
        if (lines[uuid]) {
            if (settings) {
                lines[uuid].data.settings = Object.assign(lines[uuid].data.settings || {}, settings)
            }
            if (text !== undefined) {
                lines[uuid].data.text = text
                if (lines[uuid].data.settings) lines[uuid].data.settings.text = text
            }
            if (p1) {
                lines[uuid].data.p1 = p1
                if (lines[uuid].pins[0]) {
                    lines[uuid].pins[0].t = p1[0]
                    lines[uuid].pins[0].y$ = p1[1]
                }
            }
            if (p2) {
                lines[uuid].data.p2 = p2
                if (lines[uuid].pins[1]) {
                    lines[uuid].pins[1].t = p2[0]
                    lines[uuid].pins[1].y$ = p2[1]
                }
            }
            const d = $core.dataExt.lines.find(x => x.uuid === uuid)
            if (d) {
                if (settings) d.settings = Object.assign(d.settings || {}, settings)
                if (text !== undefined) {
                    d.text = text
                    if (d.settings) d.settings.text = text
                }
                if (p1) d.p1 = p1
                if (p2) d.p2 = p2
            }
            $events.emit('update-layout')
        }
    })
}

draw(ctx) {
    for (var line of Object.values(lines)) {
        line.draw(ctx)
    }
}

newLine() {

    if (!$core.dataExt.lines) {
        $core.dataExt.lines = []
    }

    let t = $core.cursor.time
    let $ = $core.layout.y2value($core.cursor.y)
    let uuid = $lib.Utils.uuid3()

    let line = {
        type: type,
        p1: [t, $],
        p2: [t, $],
        uuid: uuid
    }

    $core.dataExt.lines.push(line)
    lines[uuid] = new $lib.TrendLine($core, line, true)
    lines[uuid].onSelect = lineSelected
    lines[uuid].selected = true

    $events.emit('tool-started', $core.uuid)
    if (type !== 'horizontal' && type !== 'ray' && type !== 'horizontal-ray' && type !== 'vertical') {
        $events.emit('scroll-lock', true)
    } else {
        $events.emit('scroll-lock', false)
    }
    $events.emit('update-layout')
    startDrawTool = false
}

lineSelected($uuid) {
    let selectedLine = null;
    for (var uuid in lines) {
        lines[uuid].selected = uuid === $uuid
        if (lines[uuid].selected) selectedLine = lines[uuid]
    }
    $events.emit('update-layout')

    if (selectedLine) {
        $events.emit('selection-event', {
            uuid: $uuid,
            overlayUuid: $core.uuid,
            type: selectedLine.data.type || 'line',
            settings: selectedLine.data.settings || {},
            data: selectedLine.data,
            x: $core.mouse ? $core.mouse.x : 0,
            y: $core.mouse ? $core.mouse.y : 0,
            gridOffset: $core.layout.sbMax[0],
            paneOffset: $core.layout.offset
        })
    } else {
        $events.emit('selection-event', null)
    }
}

unfinishedLines() {
    for (var line of Object.values(lines)) {
        if (line.pins.some(x => x.state !== 'settled')) {
            return true
        }
    }
    return false
}

mouseMoved() {
    let d = Math.abs(mouseX - $core.mouse.x)
    return d > 5
}

removeLine(uuid) {
    delete lines[uuid]
    $core.dataExt.lines = $core.dataExt.lines.filter(x => x.uuid !== uuid)
    $events.emit('update-layout')
    $events.emit('selection-event', null)
}

propagate(name, data) {
    const list = (name === 'mousedown' || name === 'click') ? Object.values(lines).slice().reverse() : Object.values(lines)
    for (var line of list) {
        line[name](data)
    }
}

mousedown(event) {
    if (startDrawTool) {
        newLine()
        return
    }

    const drawingLine = Object.values(lines).find(x => x.isDrawing || x.pins.some(p => p.state === 'tracking'))
    if (drawingLine) {
        drawingLine.mousedown(event)
        return
    }

    if (event && (event.__toolCaptured || $lib.Utils.defaultPrevented(event))) {
        return
    }

    mouseX = $core.mouse.x

    let hit = false
    for (var line of Object.values(lines).slice().reverse()) {
        if (line.collision() || line.pins.some(p => p.hover())) {
            hit = true
            break
        }
    }

    if (!hit) {
        const hadSelected = Object.values(lines).some(x => x.selected)
        if (hadSelected) {
            lineSelected(null)
        }
    }

    $events.emit('update-layout')
    propagate('mousedown', event)
}

mouseup(event) {

    propagate('mouseup', event)
}

mousemove(event) {
    propagate('mousemove', event)
}

keydown(event) {
    if (event.code === 'Backspace') {
        let s = Object.values(lines).find(x => x.selected)
        if (s) removeLine(s.data.uuid)
    }
}

legend() => null