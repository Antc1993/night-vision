// Navy ~ 0.2-lite
// <ds>Drawing triangles [3 clicks]</ds>

[OVERLAY name = TriangleTool, ctx = Canvas, version = 1.0.0]

let timeId = null
let mouseX = 0
let triangles = {} // Triangle objects stored by uuid
let startDrawTool = false

init() {
    // Restore triangles from dataExt
    for (var tri of $core.dataExt.triangles || []) {
        triangles[tri.uuid] = new $lib.Triangle($core, tri, tri.isDrawing || false)
        triangles[tri.uuid].onSelect = triangleSelected
        if (tri.isDrawing) {
            triangles[tri.uuid].selected = true
        }
    }

    const handleToolTriangle = event => {
        startDrawTool = true
    }
    $events.on($core.uuid + ':tool-triangle', handleToolTriangle)
    if ($core.dataExt && $core.dataExt.uuid) {
        $events.on($core.dataExt.uuid + ':tool-triangle', handleToolTriangle)
    }

    $events.on($core.uuid + ':tool-started', activeUuid => {
        if (activeUuid !== $core.uuid) {
            startDrawTool = false
        }
    })

    $events.on($core.uuid + ':delete-tool', uuid => {
        if (triangles[uuid]) removeTriangle(uuid)
    })

    $events.on('delete-all-tools', () => {
        for (var uuid in triangles) {
            delete triangles[uuid]
        }
        $core.dataExt.triangles = []
        $events.emit('update-layout')
        $events.emit('selection-event', null)
    })

    $events.on($core.uuid + ':selection-event', data => {
        if (data && data.overlayUuid !== $core.uuid) {
            let changed = false
            for (var uuid in triangles) {
                if (triangles[uuid].selected) {
                    triangles[uuid].selected = false
                    changed = true
                }
            }
            if (changed) $events.emit('update-layout')
        }
    })

    $events.on($core.uuid + ':update-settings', data => {
        const { uuid, settings, p1, p2, p3, text } = data
        if (triangles[uuid]) {
            if (settings) {
                triangles[uuid].data.settings = Object.assign(triangles[uuid].data.settings || {}, settings)
            }
            if (text !== undefined) {
                triangles[uuid].data.text = text
                if (triangles[uuid].data.settings) triangles[uuid].data.settings.text = text
            }
            if (p1 && triangles[uuid].pins[0]) {
                triangles[uuid].data.p1 = p1
                triangles[uuid].pins[0].t = p1[0]
                triangles[uuid].pins[0].y$ = p1[1]
            }
            if (p2 && triangles[uuid].pins[1]) {
                triangles[uuid].data.p2 = p2
                triangles[uuid].pins[1].t = p2[0]
                triangles[uuid].pins[1].y$ = p2[1]
            }
            if (p3 && triangles[uuid].pins[2]) {
                triangles[uuid].data.p3 = p3
                triangles[uuid].pins[2].t = p3[0]
                triangles[uuid].pins[2].y$ = p3[1]
            }
            const d = $core.dataExt.triangles.find(x => x.uuid === uuid)
            if (d) {
                if (settings) d.settings = Object.assign(d.settings || {}, settings)
                if (text !== undefined) {
                    d.text = text
                    if (d.settings) d.settings.text = text
                }
                if (p1) d.p1 = p1
                if (p2) d.p2 = p2
                if (p3) d.p3 = p3
            }
            triangles[uuid].update()
            $events.emit('update-layout')
        }
    })
}

draw(ctx) {
    for (var tri of Object.values(triangles)) {
        tri.draw(ctx)
    }
}

newTriangle() {
    if (!$core.dataExt.triangles) {
        $core.dataExt.triangles = []
    }

    const cursor = $core.cursor || {}
    const mouse = $core.mouse || {}
    const layout = $core.layout

    const cx = cursor.x !== undefined ? cursor.x : (mouse.x !== undefined ? mouse.x : 0)
    const cy = cursor.y !== undefined ? cursor.y : (mouse.y !== undefined ? mouse.y : 0)

    const x2tFn = layout ? (layout.x2time || layout.x2t) : null
    let t = (cursor.time != null && !isNaN(cursor.time)) ? cursor.time : cursor.ti
    if ((t == null || isNaN(t)) && x2tFn) {
        t = x2tFn.call(layout, cx)
    }
    let $ = layout ? layout.y2value(cy) : 0
    let uuid = $lib.Utils.uuid3()

    let triangleData = {
        type: 'triangle',
        p1: [t, $],
        p2: [t, $],
        p3: [t, $],
        uuid: uuid,
        isDrawing: true,
        settings: {
            color: '#33ff33',
            lineWidth: 1.5,
            fill: true,
            fillColor: '#33ff33',
            fillOpacity: 20
        }
    }

    $core.dataExt.triangles.push(triangleData)
    triangles[uuid] = new $lib.Triangle($core, triangleData, true)
    triangles[uuid].onSelect = triangleSelected
    triangles[uuid].selected = true

    $events.emit('tool-started', $core.uuid)
    $events.emit('scroll-lock', true)
    $events.emit('update-layout')
    startDrawTool = false
}

triangleSelected($uuid, openSettings = false) {
    let selectedTri = null
    for (var uuid in triangles) {
        triangles[uuid].selected = uuid === $uuid
        if (triangles[uuid].selected) selectedTri = triangles[uuid]
    }

    $events.emit('update-layout')

    if (selectedTri) {
        $events.emit('selection-event', {
            uuid: $uuid,
            overlayUuid: $core.uuid,
            type: 'triangle',
            settings: selectedTri.data.settings || {},
            data: selectedTri.data,
            x: $core.mouse ? $core.mouse.x : 0,
            y: $core.mouse ? $core.mouse.y : 0,
            gridOffset: $core.layout.sbMax[0],
            paneOffset: $core.layout.offset,
            openSettings: openSettings
        })
    } else {
        $events.emit('selection-event', null)
    }
}

removeTriangle(uuid) {
    delete triangles[uuid]
    $core.dataExt.triangles = $core.dataExt.triangles.filter(x => x.uuid !== uuid)
    $events.emit('update-layout')
    $events.emit('selection-event', null)
}

propagate(name, data) {
    const list = (name === 'mousedown' || name === 'click' || name === 'dblclick') ? Object.values(triangles).slice().reverse() : Object.values(triangles)
    for (var tri of list) {
        if (tri[name]) tri[name](data)
    }
}

dblclick(event) {
    if (startDrawTool) return
    const drawingTri = Object.values(triangles).find(x => x.isDrawing || x.pins.some(p => p.state === 'tracking'))
    if (drawingTri) return

    for (var tri of Object.values(triangles).slice().reverse()) {
        if (tri.collision() || (tri.pins && tri.pins.some(p => p.hover()))) {
            triangleSelected(tri.data.uuid, true)
            if (event) {
                event.__toolCaptured = true
                if (event.stopPropagation) event.stopPropagation()
            }
            return
        }
    }
}

mousedown(event) {
    if (startDrawTool) {
        newTriangle()
        return
    }

    const drawingTri = Object.values(triangles).find(x => x.isDrawing || x.pins.some(p => p.state === 'tracking'))
    if (drawingTri) {
        drawingTri.mousedown(event)
        return
    }

    if (event && (event.__toolCaptured || $lib.Utils.defaultPrevented(event))) {
        return
    }

    if (event && event.detail === 2) {
        for (var tri of Object.values(triangles).slice().reverse()) {
            if (tri.collision() || (tri.pins && tri.pins.some(p => p.hover()))) {
                triangleSelected(tri.data.uuid, true)
                event.__toolCaptured = true
                return
            }
        }
    }

    mouseX = $core.mouse.x

    let hit = false
    for (var tri of Object.values(triangles).slice().reverse()) {
        if (tri.collision() || tri.pins.some(p => p.hover())) {
            hit = true
            break
        }
    }

    if (!hit) {
        const hadSelected = Object.values(triangles).some(x => x.selected)
        if (hadSelected) {
            triangleSelected(null)
        }
    }

    $events.emit('update-layout')
    propagate('mousedown', event)
}

mouseup(event) {
    propagate('mouseup', event)
}

mousemove(event) {
    propagate('mousemove', event)
}

keydown(event) {
    if (event.code === 'Backspace' || event.code === 'Delete') {
        let s = Object.values(triangles).find(x => x.selected)
        if (s) removeTriangle(s.data.uuid)
    }
}

legend() => null
