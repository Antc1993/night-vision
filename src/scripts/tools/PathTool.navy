// Navy ~ 0.2-lite
// <ds>Drawing polyline / vector path [multi-click, dblclick/Enter to finish]</ds>

[OVERLAY name = PathTool, ctx = Canvas, version = 1.0.0]

let timeId = null
let mouseX = 0
let paths = {} // Path objects stored by uuid
let startDrawTool = false

init() {
    // Restore paths from dataExt
    for (var p of $core.dataExt.paths || []) {
        paths[p.uuid] = new $lib.PathToolPrimitive($core, p, p.isDrawing || false)
        paths[p.uuid].onSelect = pathSelected
        if (p.isDrawing) {
            paths[p.uuid].selected = true
        }
    }

    const handleToolPath = event => {
        startDrawTool = true
    }
    $events.on($core.uuid + ':tool-path', handleToolPath)
    if ($core.dataExt && $core.dataExt.uuid) {
        $events.on($core.dataExt.uuid + ':tool-path', handleToolPath)
    }

    $events.on($core.uuid + ':tool-started', activeUuid => {
        if (activeUuid !== $core.uuid) {
            startDrawTool = false
        }
    })

    $events.on($core.uuid + ':delete-tool', uuid => {
        if (paths[uuid]) removePath(uuid)
    })

    $events.on('delete-all-tools', () => {
        for (var uuid in paths) {
            delete paths[uuid]
        }
        $core.dataExt.paths = []
        $events.emit('update-layout')
        $events.emit('selection-event', null)
    })

    $events.on($core.uuid + ':selection-event', data => {
        if (data && data.overlayUuid !== $core.uuid) {
            let changed = false
            for (var uuid in paths) {
                if (paths[uuid].selected) {
                    paths[uuid].selected = false
                    changed = true
                }
            }
            if (changed) $events.emit('update-layout')
        }
    })

    $events.on($core.uuid + ':update-settings', data => {
        const { uuid, settings, text } = data
        if (paths[uuid]) {
            if (settings) {
                paths[uuid].data.settings = Object.assign(paths[uuid].data.settings || {}, settings)
            }
            if (text !== undefined) {
                paths[uuid].data.text = text
                if (paths[uuid].data.settings) paths[uuid].data.settings.text = text
            }
            const d = $core.dataExt.paths.find(x => x.uuid === uuid)
            if (d) {
                if (settings) d.settings = Object.assign(d.settings || {}, settings)
                if (text !== undefined) {
                    d.text = text
                    if (d.settings) d.settings.text = text
                }
            }
            paths[uuid].update()
            $events.emit('update-layout')
        }
    })
}

draw(ctx) {
    for (var p of Object.values(paths)) {
        p.draw(ctx)
    }
}

newPath() {
    if (!$core.dataExt.paths) {
        $core.dataExt.paths = []
    }

    const cursor = $core.cursor || {}
    const mouse = $core.mouse || {}
    const layout = $core.layout

    const cx = cursor.x !== undefined ? cursor.x : (mouse.x !== undefined ? mouse.x : 0)
    const cy = cursor.y !== undefined ? cursor.y : (mouse.y !== undefined ? mouse.y : 0)

    const x2tFn = layout ? (layout.x2time || layout.x2t) : null
    let t = (cursor.time != null && !isNaN(cursor.time)) ? cursor.time : cursor.ti
    if ((t == null || isNaN(t)) && x2tFn) {
        t = x2tFn.call(layout, cx)
    }
    let $ = layout ? layout.y2value(cy) : 0
    let uuid = $lib.Utils.uuid3()

    let pathData = {
        type: 'path',
        points: [
            [t, $],
            [t, $]
        ],
        closed: false,
        uuid: uuid,
        isDrawing: true,
        settings: {
            color: '#2962ff',
            lineWidth: 2,
            lineStyle: 'solid',
            arrow: true,
            fill: false,
            fillColor: '#2962ff',
            fillOpacity: 15
        }
    }

    $core.dataExt.paths.push(pathData)
    paths[uuid] = new $lib.PathToolPrimitive($core, pathData, true)
    paths[uuid].onSelect = pathSelected
    paths[uuid].selected = true

    $events.emit('tool-started', $core.uuid)
    $events.emit('scroll-lock', true)
    $events.emit('hub:set-drawing-in-progress', true)
    $events.emit('update-layout')
    startDrawTool = false
    if (event) event.__toolCaptured = true
}

pathSelected($uuid, openSettings = false) {
    let selectedPath = null
    for (var uuid in paths) {
        paths[uuid].selected = uuid === $uuid
        if (paths[uuid].selected) selectedPath = paths[uuid]
    }

    $events.emit('update-layout')

    if (selectedPath) {
        $events.emit('selection-event', {
            uuid: $uuid,
            overlayUuid: $core.uuid,
            type: 'path',
            settings: selectedPath.data.settings || {},
            data: selectedPath.data,
            x: $core.mouse ? $core.mouse.x : 0,
            y: $core.mouse ? $core.mouse.y : 0,
            gridOffset: $core.layout.sbMax[0],
            paneOffset: $core.layout.offset,
            openSettings: openSettings
        })
    } else {
        $events.emit('selection-event', null)
    }
}

removePath(uuid) {
    delete paths[uuid]
    $core.dataExt.paths = $core.dataExt.paths.filter(x => x.uuid !== uuid)
    $events.emit('update-layout')
    $events.emit('selection-event', null)
}

propagate(name, data) {
    const list = (name === 'mousedown' || name === 'click' || name === 'dblclick') ? Object.values(paths).slice().reverse() : Object.values(paths)
    for (var p of list) {
        if (p[name]) p[name](data)
    }
}

dblclick(event) {
    if (startDrawTool) return
    const drawingPath = Object.values(paths).find(x => x.isDrawing || x.pins.some(p => p.state === 'tracking'))
    if (drawingPath) {
        drawingPath.finishDrawing()
        if (event) {
            event.__toolCaptured = true
            if (event.stopPropagation) event.stopPropagation()
        }
        return
    }
    if ($core.hub?.isDrawingMode && $core.hub.isDrawingMode()) return

    for (var p of Object.values(paths).slice().reverse()) {
        if (p.collision() || (p.pins && p.pins.some(pin => pin.hover()))) {
            pathSelected(p.data.uuid, true)
            if (event) {
                event.__toolCaptured = true
                if (event.stopPropagation) event.stopPropagation()
            }
            return
        }
    }
}

mousedown(event) {
    if (startDrawTool) {
        newPath(event)
        if (event) event.__toolCaptured = true
        return
    }

    const drawingPath = Object.values(paths).find(x => x.isDrawing || x.pins.some(p => p.state === 'tracking'))
    if (drawingPath) {
        // Check for double click simulation or direct click
        if (event && event.detail === 2) {
            drawingPath.finishDrawing()
            if (event) event.__toolCaptured = true
            return
        }
        drawingPath.mousedown(event)
        if (event) event.__toolCaptured = true
        return
    }

    if ($core.hub?.isDrawingMode && $core.hub.isDrawingMode()) {
        return
    }

    if (event && (event.__toolCaptured || $lib.Utils.defaultPrevented(event))) {
        return
    }

    if (event && event.detail === 2) {
        for (var p of Object.values(paths).slice().reverse()) {
            if (p.collision() || (p.pins && p.pins.some(pin => pin.hover()))) {
                pathSelected(p.data.uuid, true)
                event.__toolCaptured = true
                return
            }
        }
    }

    mouseX = $core.mouse.x

    let hit = false
    for (var p of Object.values(paths).slice().reverse()) {
        if (p.collision() || p.pins.some(pin => pin.hover())) {
            hit = true
            break
        }
    }

    if (!hit) {
        const hadSelected = Object.values(paths).some(x => x.selected)
        if (hadSelected) {
            pathSelected(null)
        }
    }

    $events.emit('update-layout')
    propagate('mousedown', event)
}

mouseup(event) {
    propagate('mouseup', event)
}

mousemove(event) {
    propagate('mousemove', event)
}

keydown(event) {
    const drawingPath = Object.values(paths).find(x => x.isDrawing || x.pins.some(p => p.state === 'tracking'))
    if (drawingPath && (event.code === 'Enter' || event.code === 'Escape')) {
        drawingPath.finishDrawing()
        $events.emit('hub:set-drawing-in-progress', false)
        $events.emit('hub:set-drawing-tool', null)
        return
    }
    if (startDrawTool && event.code === 'Escape') {
        startDrawTool = false
        $events.emit('hub:set-drawing-tool', null)
        return
    }

    if (event.code === 'Backspace' || event.code === 'Delete') {
        let s = Object.values(paths).find(x => x.selected)
        if (s) removePath(s.data.uuid)
    }
}

legend() => null
