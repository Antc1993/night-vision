// Navy ~ 0.2-lite
// <ds>Fibonacci Retracement Tool [Tap + Hold]</ds>

[OVERLAY name = FibonacciRetracementTool, ctx = Canvas, verion = 1.0.0]

let timeId = null
let mouseX = 0
let fibos = {} // Fibonacci objects stored by uuid
let startDrawTool = false

init() {
    // Restore fibos from dataExt
    for (var fibo of $core.dataExt.fibos || []) {
        if (fibo.type === 'fibo-circle') {
            fibos[fibo.uuid] = new $lib.FiboCircle($core, fibo, fibo.isDrawing || false)
        } else if (fibo.type === 'fibo-wedge') {
            fibos[fibo.uuid] = new $lib.FiboWedge($core, fibo, fibo.isDrawing || false)
        } else {
            fibos[fibo.uuid] = new $lib.FiboRetracement($core, fibo, fibo.isDrawing || false)
        }
        fibos[fibo.uuid].onSelect = fiboSelected
        if (fibo.isDrawing) {
            fibos[fibo.uuid].selected = true
        }
    }

    const handleToolFibos = event => {
        startDrawTool = 'fibonacci'
    }
    const handleToolFiboCircle = event => {
        startDrawTool = 'fibo-circle'
    }
    const handleToolFiboWedge = event => {
        startDrawTool = 'fibo-wedge'
    }
    $events.on($core.uuid + ':tool-fibos', handleToolFibos)
    $events.on($core.uuid + ':tool-fibo-circle', handleToolFiboCircle)
    $events.on($core.uuid + ':tool-fibo-wedge', handleToolFiboWedge)
    if ($core.dataExt && $core.dataExt.uuid) {
        $events.on($core.dataExt.uuid + ':tool-fibos', handleToolFibos)
        $events.on($core.dataExt.uuid + ':tool-fibo-circle', handleToolFiboCircle)
        $events.on($core.dataExt.uuid + ':tool-fibo-wedge', handleToolFiboWedge)
    }

    $events.on($core.uuid + ':tool-started', activeUuid => {
        if (activeUuid !== $core.uuid) {
            startDrawTool = false
        }
    })

    $events.on($core.uuid + ':delete-tool', uuid => {
        if (fibos[uuid]) removeFibo(uuid)
    })

    $events.on('delete-all-tools', () => {
        for (var uuid in fibos) {
            delete fibos[uuid]
        }
        $core.dataExt.fibos = []
        $events.emit('update-layout')
        $events.emit('selection-event', null)
    })

    $events.on($core.uuid + ':selection-event', data => {
        if (data && data.overlayUuid !== $core.uuid) {
            let changed = false
            for (var uuid in fibos) {
                if (fibos[uuid].selected) {
                    fibos[uuid].selected = false
                    changed = true
                }
            }
            if (changed) $events.emit('update-layout')
        }
    })

    $events.on($core.uuid + ':update-settings', data => {
        const { uuid, settings, p1, p2, p3, text } = data
        if (fibos[uuid]) {
            if (settings) {
                fibos[uuid].data.settings = Object.assign(fibos[uuid].data.settings || {}, settings)
            }
            if (text !== undefined) {
                fibos[uuid].data.text = text
                if (fibos[uuid].data.settings) fibos[uuid].data.settings.text = text
            }
            if (p1) {
                fibos[uuid].data.p1 = p1
                if (fibos[uuid].pins[0]) {
                    fibos[uuid].pins[0].t = p1[0]
                    fibos[uuid].pins[0].y$ = p1[1]
                }
            }
            if (p2) {
                fibos[uuid].data.p2 = p2
                if (fibos[uuid].pins[1]) {
                    fibos[uuid].pins[1].t = p2[0]
                    fibos[uuid].pins[1].y$ = p2[1]
                }
            }
            if (p3) {
                fibos[uuid].data.p3 = p3
                if (fibos[uuid].pins[2]) {
                    fibos[uuid].pins[2].t = p3[0]
                    fibos[uuid].pins[2].y$ = p3[1]
                }
            }
            const d = $core.dataExt.fibos.find(x => x.uuid === uuid)
            if (d) {
                if (settings) d.settings = Object.assign(d.settings || {}, settings)
                if (text !== undefined) {
                    d.text = text
                    if (d.settings) d.settings.text = text
                }
                if (p1) d.p1 = p1
                if (p2) d.p2 = p2
                if (p3) d.p3 = p3
            }
            $events.emit('update-layout')
        }
    })
}

draw(ctx) {
    for (var fibo of Object.values(fibos)) {
        fibo.draw(ctx)
    }
}

newFibo(event, toolType = 'fibonacci') {

    if (!$core.dataExt.fibos) {
        $core.dataExt.fibos = []
    }

    const cursor = $core.cursor || {}
    const mouse = $core.mouse || {}
    const layout = $core.layout

    const cx = cursor.x !== undefined ? cursor.x : (mouse.x !== undefined ? mouse.x : 0)
    const cy = cursor.y !== undefined ? cursor.y : (mouse.y !== undefined ? mouse.y : 0)

    const x2tFn = layout ? (layout.x2time || layout.x2t) : null
    let t = (cursor.time != null && !isNaN(cursor.time)) ? cursor.time : cursor.ti
    if ((t == null || isNaN(t)) && x2tFn) {
        t = x2tFn.call(layout, cx)
    }
    let $ = layout ? layout.y2value(cy) : 0
    let uuid = $lib.Utils.uuid3()

    let fibo = {
        p1: [t, $],
        p2: [t, $],
        uuid: uuid,
        type: toolType,
        isDrawing: true
    }
    if (toolType === 'fibo-wedge') {
        fibo.p3 = [t, $]
    }

    $core.dataExt.fibos.push(fibo)
    if (toolType === 'fibo-circle') {
        fibos[uuid] = new $lib.FiboCircle($core, fibo, true)
    } else if (toolType === 'fibo-wedge') {
        fibos[uuid] = new $lib.FiboWedge($core, fibo, true)
    } else {
        fibos[uuid] = new $lib.FiboRetracement($core, fibo, true)
    }

    fibos[uuid].onSelect = fiboSelected
    fibos[uuid].selected = true

    $events.emit('tool-started', $core.uuid)
    $events.emit('scroll-lock', true)
    $events.emit('hub:set-drawing-in-progress', true)
    $events.emit('update-layout')
    startDrawTool = false
    if (event) event.__toolCaptured = true
}

fiboSelected($uuid, openSettings = false) {
    let selectedFibo = null;
    for (var uuid in fibos) {
        fibos[uuid].selected = uuid === $uuid
        if (fibos[uuid].selected) selectedFibo = fibos[uuid]
    }
    $events.emit('update-layout')

    if (selectedFibo) {
        $events.emit('selection-event', {
            uuid: $uuid,
            overlayUuid: $core.uuid,
            type: selectedFibo.data.type || 'fibonacci',
            settings: selectedFibo.data.settings || {},
            data: selectedFibo.data,
            x: $core.mouse ? $core.mouse.x : 0,
            y: $core.mouse ? $core.mouse.y : 0,
            gridOffset: $core.layout.sbMax[0],
            paneOffset: $core.layout.offset,
            openSettings: openSettings
        })
    } else {
        $events.emit('selection-event', null)
    }
}

unfinishedFibos() {
    for (var fibo of Object.values(fibos)) {
        if (fibo.pins.some(x => x.state !== 'settled')) {
            return true
        }
    }
    return false
}

mouseMoved() {
    let d = Math.abs(mouseX - $core.mouse.x)
    return d > 5
}

removeFibo(uuid) {
    delete fibos[uuid]
    $core.dataExt.fibos = $core.dataExt.fibos.filter(x => x.uuid !== uuid)
    $events.emit('update-layout')
    $events.emit('selection-event', null)
}

propagate(name, data) {
    const list = (name === 'mousedown' || name === 'click' || name === 'dblclick') ? Object.values(fibos).slice().reverse() : Object.values(fibos)
    for (var fibo of list) {
        if (fibo[name]) fibo[name](data)
    }
}

dblclick(event) {
    if (startDrawTool) return
    const drawingFibo = Object.values(fibos).find(x => x.isDrawing || x.pins.some(p => p.state === 'tracking'))
    if (drawingFibo) return
    if ($core.hub?.isDrawingMode && $core.hub.isDrawingMode()) return

    for (var fibo of Object.values(fibos).slice().reverse()) {
        if (fibo.collision() || (fibo.pins && fibo.pins.some(p => p.hover()))) {
            fiboSelected(fibo.data.uuid, true)
            if (event) {
                event.__toolCaptured = true
                if (event.stopPropagation) event.stopPropagation()
            }
            return
        }
    }
}

mousedown(event) {
    if (startDrawTool) {
        const typeToDraw = typeof startDrawTool === 'string' ? startDrawTool : 'fibonacci'
        newFibo(event, typeToDraw)
        if (event) event.__toolCaptured = true
        return
    }

    const drawingFibo = Object.values(fibos).find(x => x.isDrawing || x.pins.some(p => p.state === 'tracking'))
    if (drawingFibo) {
        drawingFibo.mousedown(event)
        if (event) event.__toolCaptured = true
        return
    }

    if ($core.hub?.isDrawingMode && $core.hub.isDrawingMode()) {
        return
    }

    if (event && (event.__toolCaptured || $lib.Utils.defaultPrevented(event))) {
        return
    }

    if (event && event.detail === 2) {
        for (var fibo of Object.values(fibos).slice().reverse()) {
            if (fibo.collision() || (fibo.pins && fibo.pins.some(p => p.hover()))) {
                fiboSelected(fibo.data.uuid, true)
                event.__toolCaptured = true
                return
            }
        }
    }

    mouseX = $core.mouse.x

    let hit = false
    for (var fibo of Object.values(fibos).slice().reverse()) {
        if (fibo.collision() || fibo.pins.some(p => p.hover())) {
            hit = true
            break
        }
    }

    if (!hit) {
        const hadSelected = Object.values(fibos).some(x => x.selected)
        if (hadSelected) {
            fiboSelected(null)
        }
    }

    $events.emit('update-layout')
    propagate('mousedown', event)
}

mouseup(event) {
    propagate('mouseup', event)
}

mousemove(event) {
    propagate('mousemove', event)
}

keydown(event) {
    if (event.code === 'Escape') {
        const drawingFibo = Object.values(fibos).find(x => x.isDrawing || x.pins.some(p => p.state === 'tracking'))
        if (drawingFibo) {
            removeFibo(drawingFibo.data.uuid)
            $events.emit('scroll-lock', false)
            $events.emit('hub:set-drawing-in-progress', false)
            $events.emit('hub:set-drawing-tool', null)
            return
        }
        if (startDrawTool) {
            startDrawTool = false
            $events.emit('hub:set-drawing-tool', null)
            return
        }
    }

    if (event.code === 'Backspace' || event.code === 'Delete') {
        let s = Object.values(fibos).find(x => x.selected)
        if (s) removeFibo(s.data.uuid)
    }
}

legend() => null
