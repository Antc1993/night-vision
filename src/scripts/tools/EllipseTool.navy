// Navy ~ 0.2-lite
// <ds>Drawing ellipses [Bounding Box]</ds>

[OVERLAY name = EllipseTool, ctx = Canvas, version = 1.0.0]

let timeId = null
let mouseX = 0
let ellipses = {} // Ellipse objects stored by uuid
let startDrawTool = false

init() {
    // Restore ellipses from dataExt
    for (var el of $core.dataExt.ellipses || []) {
        ellipses[el.uuid] = new $lib.Ellipse($core, el, el.isDrawing || false)
        ellipses[el.uuid].onSelect = ellipseSelected
        if (el.isDrawing) {
            ellipses[el.uuid].selected = true
        }
    }

    const handleToolEllipse = event => {
        startDrawTool = true
    }
    $events.on($core.uuid + ':tool-ellipse', handleToolEllipse)
    if ($core.dataExt && $core.dataExt.uuid) {
        $events.on($core.dataExt.uuid + ':tool-ellipse', handleToolEllipse)
    }

    $events.on($core.uuid + ':tool-started', activeUuid => {
        if (activeUuid !== $core.uuid) {
            startDrawTool = false
        }
    })

    $events.on($core.uuid + ':delete-tool', uuid => {
        if (ellipses[uuid]) removeEllipse(uuid)
    })

    $events.on('delete-all-tools', () => {
        for (var uuid in ellipses) {
            delete ellipses[uuid]
        }
        $core.dataExt.ellipses = []
        $events.emit('update-layout')
        $events.emit('selection-event', null)
    })

    $events.on($core.uuid + ':selection-event', data => {
        if (data && data.overlayUuid !== $core.uuid) {
            let changed = false
            for (var uuid in ellipses) {
                if (ellipses[uuid].selected) {
                    ellipses[uuid].selected = false
                    changed = true
                }
            }
            if (changed) $events.emit('update-layout')
        }
    })

    $events.on($core.uuid + ':update-settings', data => {
        const { uuid, settings, p1, p2, p3, p4, text } = data
        if (ellipses[uuid]) {
            if (settings) {
                ellipses[uuid].data.settings = Object.assign(ellipses[uuid].data.settings || {}, settings)
            }
            if (text !== undefined) {
                ellipses[uuid].data.text = text
                if (ellipses[uuid].data.settings) ellipses[uuid].data.settings.text = text
            }
            if (p1 && ellipses[uuid].pins[0]) {
                ellipses[uuid].data.p1 = p1
                ellipses[uuid].pins[0].t = p1[0]
                ellipses[uuid].pins[0].y$ = p1[1]
            }
            if (p2 && ellipses[uuid].pins[1]) {
                ellipses[uuid].data.p2 = p2
                ellipses[uuid].pins[1].t = p2[0]
                ellipses[uuid].pins[1].y$ = p2[1]
            }
            if (p3 && ellipses[uuid].pins[2]) {
                ellipses[uuid].data.p3 = p3
                ellipses[uuid].pins[2].t = p3[0]
                ellipses[uuid].pins[2].y$ = p3[1]
            }
            if (p4 && ellipses[uuid].pins[3]) {
                ellipses[uuid].data.p4 = p4
                ellipses[uuid].pins[3].t = p4[0]
                ellipses[uuid].pins[3].y$ = p4[1]
            }
            const d = $core.dataExt.ellipses.find(x => x.uuid === uuid)
            if (d) {
                if (settings) d.settings = Object.assign(d.settings || {}, settings)
                if (text !== undefined) {
                    d.text = text
                    if (d.settings) d.settings.text = text
                }
                if (p1) d.p1 = p1
                if (p2) d.p2 = p2
                if (p3) d.p3 = p3
                if (p4) d.p4 = p4
            }
            $events.emit('update-layout')
        }
    })
}

draw(ctx) {
    for (var el of Object.values(ellipses)) {
        el.draw(ctx)
    }
}

newEllipse() {
    if (!$core.dataExt.ellipses) {
        $core.dataExt.ellipses = []
    }

    const cursor = $core.cursor || {}
    const mouse = $core.mouse || {}
    const layout = $core.layout

    const cx = cursor.x !== undefined ? cursor.x : (mouse.x !== undefined ? mouse.x : 0)
    const cy = cursor.y !== undefined ? cursor.y : (mouse.y !== undefined ? mouse.y : 0)

    const x2tFn = layout ? (layout.x2time || layout.x2t) : null
    let t = (cursor.time != null && !isNaN(cursor.time)) ? cursor.time : cursor.ti
    if ((t == null || isNaN(t)) && x2tFn) t = x2tFn.call(layout, cx)
    let $ = layout ? layout.y2value(cy) : 0
    let uuid = $lib.Utils.uuid3()

    let el = {
        type: 'ellipse',
        p1: [t, $],
        p2: [t, $],
        p3: [t, $],
        p4: [t, $],
        uuid: uuid,
        isDrawing: true
    }

    $core.dataExt.ellipses.push(el)
    ellipses[uuid] = new $lib.Ellipse($core, el, true)
    ellipses[uuid].onSelect = ellipseSelected
    ellipses[uuid].selected = false

    $events.emit('tool-started', $core.uuid)
    $events.emit('scroll-lock', true)
    $events.emit('hub:set-drawing-in-progress', true)
    $events.emit('update-layout')
    startDrawTool = false
    if (event) event.__toolCaptured = true
}

ellipseSelected($uuid, openSettings = false) {
    let selectedEllipse = null
    for (var uuid in ellipses) {
        ellipses[uuid].selected = uuid === $uuid
        if (ellipses[uuid].selected) selectedEllipse = ellipses[uuid]
    }
    $events.emit('update-layout')

    if (selectedEllipse) {
        $events.emit('selection-event', {
            uuid: $uuid,
            overlayUuid: $core.uuid,
            type: 'ellipse',
            settings: selectedEllipse.data.settings || {},
            data: selectedEllipse.data,
            x: $core.mouse ? $core.mouse.x : 0,
            y: $core.mouse ? $core.mouse.y : 0,
            gridOffset: $core.layout.sbMax[0],
            paneOffset: $core.layout.offset,
            openSettings: openSettings
        })
    } else {
        $events.emit('selection-event', null)
    }
}

removeEllipse(uuid) {
    delete ellipses[uuid]
    if ($core.dataExt.ellipses) {
        $core.dataExt.ellipses = $core.dataExt.ellipses.filter(x => x.uuid !== uuid)
    }
    $events.emit('update-layout')
}

propagate(name, data) {
    const list = (name === 'mousedown' || name === 'click') ? Object.values(ellipses).slice().reverse() : Object.values(ellipses)
    for (var el of list) {
        el[name](data)
    }
}

mousedown(event) {
    if (startDrawTool) {
        newEllipse(event)
        if (event) event.__toolCaptured = true
        return
    }

    const drawingEllipse = Object.values(ellipses).find(x => x.isDrawing || x.pins.some(p => p.state === 'tracking'))
    if (drawingEllipse) {
        drawingEllipse.mousedown(event)
        if (event) event.__toolCaptured = true
        return
    }

    if ($core.hub?.isDrawingMode && $core.hub.isDrawingMode()) {
        return
    }

    if (event && (event.__toolCaptured || $lib.Utils.defaultPrevented(event))) {
        return
    }

    if (event && event.detail === 2) {
        for (var el of Object.values(ellipses).slice().reverse()) {
            if (el.collision() || (el.pins && el.pins.some(p => p.hover()))) {
                ellipseSelected(el.data.uuid, true)
                event.__toolCaptured = true
                return
            }
        }
    }

    mouseX = $core.mouse ? $core.mouse.x : 0

    let hit = false
    for (var el of Object.values(ellipses).slice().reverse()) {
        if (el.collision() || (el.pins && el.pins.some(p => p.hover()))) {
            hit = true
            break
        }
    }

    if (!hit) {
        const hadSelected = Object.values(ellipses).some(x => x.selected)
        if (hadSelected) {
            ellipseSelected(null)
        }
    }

    $events.emit('update-layout')
    propagate('mousedown', event)
}

mouseup(event) {
    propagate('mouseup', event)
}

mousemove(event) {
    propagate('mousemove', event)
}

dblclick(event) {
    if ($core.hub?.isDrawingMode && $core.hub.isDrawingMode()) {
        return
    }
    propagate('dblclick', event)
}

keydown(event) {
    if (event.key === 'Delete' || event.key === 'Backspace') {
        const activeUuid = Object.keys(ellipses).find(u => ellipses[u].selected)
        if (activeUuid) {
            removeEllipse(activeUuid)
            $events.emit('selection-event', null)
        }
    }
    if (event.key === 'Escape') {
        const drawingEllipse = Object.values(ellipses).find(x => x.isDrawing)
        if (drawingEllipse) {
            removeEllipse(drawingEllipse.data.uuid)
            $events.emit('scroll-lock', false)
            $events.emit('hub:set-drawing-in-progress', false)
            $events.emit('hub:set-drawing-tool', null)
        }
        startDrawTool = false
        $events.emit('update-layout')
    }
}
