
// Navy ~ 0.2-lite

// <ds>Volume chart overlay with optional SMA</ds> 
// Format: [<timestamp>, <volume>, <direction>]
// <direction> :: 1 for green volume, -1 for red volume

[OVERLAY name=Volume, ctx=Canvas, version=1.2.0]

// Overlay props
prop('colorVolUp', { type: 'color', def: '#26a69a82' })
prop('colorVolDw', { type: 'color', def: '#ef535082' })
prop('currencySymbol', { type: 'string', def: '' })
prop('showAvgVolume', { type: 'boolean', def: true })
prop('avgVolumeSMA', { type: 'number', def: 20 })
prop('colorAvgVol', { type: 'color', def: '#2962ff' })
prop('barsHeight', { type: 'number', def: 0.2, step: 0.05 })
prop('precision', { type: 'number', def: 2 })

// Draw call
draw(ctx) {
    const layout = $core.layout
    const data = $core.data
    const view = $core.view
    if (!data || !data.length || !view) return

    const config = $core.props.config
    const pxStep = layout.pxStep || 8
    const w = Math.max(Math.floor(pxStep * (config.CANDLEW || 0.75)), 1)
    const halfW = Math.floor(w / 2)
    const baseY = layout.height

    const isMainPane = $core.paneId === 0
    let maxV = 0
    for (let i = view.i1, n = view.i2; i <= n; i++) {
        let p = data[i]
        if (p && p[1] > maxV) maxV = p[1]
    }
    if (maxV === 0) maxV = 1

    const scaleH = isMainPane ? (baseY * ($props.barsHeight || 0.2)) : (baseY * 0.85)

    let upBars = []
    let dwBars = []
    let smaPoints = []
    const smaPeriod = $props.avgVolumeSMA || 20

    // Draw bars
    for (let i = view.i1, n = view.i2; i <= n; i++) {
        let p = data[i]
        if (!p) continue
        let vol = p[1] || 0
        let dir = p[2] !== undefined ? p[2] : 1
        let x = layout.ti2x(p[0], i)
        
        let barH = Math.max((vol / maxV) * scaleH, 1)
        let y = baseY - barH

        let bar = { x: x - halfW, y: y, w: w, h: barH }
        if (dir > 0) upBars.push(bar)
        else dwBars.push(bar)

        // Compute SMA
        if ($props.showAvgVolume && i >= 0) {
            let sum = 0, count = 0
            for (let j = Math.max(0, i - smaPeriod + 1); j <= i; j++) {
                if (data[j]) {
                    sum += data[j][1] || 0
                    count++
                }
            }
            if (count > 0) {
                let avg = sum / count
                let smaH = (avg / maxV) * scaleH
                smaPoints.push({ x: x, y: baseY - smaH })
            }
        }
    }

    // 1. Draw down bars
    if (dwBars.length > 0) {
        ctx.fillStyle = $props.colorVolDw
        ctx.beginPath()
        for (let i = 0; i < dwBars.length; i++) {
            let b = dwBars[i]
            ctx.rect(b.x, b.y, b.w, b.h)
        }
        ctx.fill()
    }

    // 2. Draw up bars
    if (upBars.length > 0) {
        ctx.fillStyle = $props.colorVolUp
        ctx.beginPath()
        for (let i = 0; i < upBars.length; i++) {
            let b = upBars[i]
            ctx.rect(b.x, b.y, b.w, b.h)
        }
        ctx.fill()
    }

    // 3. Draw SMA line
    if ($props.showAvgVolume && smaPoints.length > 1) {
        ctx.strokeStyle = $props.colorAvgVol
        ctx.lineWidth = 1.5
        ctx.lineJoin = 'round'
        ctx.beginPath()
        ctx.moveTo(smaPoints[0].x, smaPoints[0].y)
        for (let i = 1; i < smaPoints.length; i++) {
            ctx.lineTo(smaPoints[i].x, smaPoints[i].y)
        }
        ctx.stroke()
    }
}

// Custom y-range: only scale in sub-panel, return null in main pane
yRange(data, hi, lo) {
    if ($core.paneId === 0) return null
    if (!data || !data.length) return null
    let max = 0
    for (let i = 0; i < data.length; i++) {
        let v = data[i][1] || 0
        if (v > max) max = v
    }
    return [max * 1.15, 0]
}

// Precision detection
static preSampler(x) => [x && x[1] !== undefined ? Math.round(x[1] * 100) / 100 : 0]

// Legend
legendHtml(x, prec, f) {
    let color1 = $core.colors.text
    let v = $core.cursor.getValue($core.paneId, $core.id) || x || []
    let dir = v[2] !== undefined ? v[2] : 1
    let color = dir > 0 ? $props.colorVolUp : $props.colorVolDw
    let fc = $lib.formatCash
    let val = (x && x[1] !== undefined) ? x[1] : (v[1] !== undefined ? v[1] : 0)
    let sym = $props.currencySymbol || ''
    
    // SMA Value
    let data = $core.data
    let smaStr = ''
    if ($props.showAvgVolume && data && data.length) {
        let ti = (x && x[0]) || (v && v[0])
        let idx = data.findIndex(p => p[0] === ti)
        if (idx === -1) idx = data.length - 1
        let smaPeriod = $props.avgVolumeSMA || 20
        let sum = 0, count = 0
        for (let j = Math.max(0, idx - smaPeriod + 1); j <= idx; j++) {
            if (data[j]) { sum += data[j][1] || 0; count++ }
        }
        if (count > 0) {
            let avg = sum / count
            smaStr = `<span style="color: ${color1}; margin-left: 8px;">SMA ${smaPeriod}:</span> <span style="color: ${$props.colorAvgVol}; font-weight: 600;">${sym}${fc(avg)}</span>`
        }
    }

    return `
    <span>
        <span style="color: ${color1}">Vol:</span>
        <span class="nvjs-ll-value" style="color: ${color}; font-weight: 600;">${sym}${fc(val)}</span>
        ${smaStr}
    </span>`
}
