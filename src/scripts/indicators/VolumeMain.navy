
// Navy ~ 0.2-lite
// <ds>Volume Overlay (Main Chart)</ds>

[INDICATOR name=VolumeMain, version=1.0.0]

prop('length', { type: 'integer', def: 20 })
prop('colorVolUp', { type: 'color', def: '#26a69a55' })
prop('colorVolDw', { type: 'color', def: '#ef535055' })
prop('barsHeight', { type: 'number', def: 0.18, step: 0.02 })
prop('showSMA', { type: 'boolean', def: true })
prop('colorSMA', { type: 'color', def: '#2962ffaa' })
prop('zIndex', { type: 'integer', def: 0 })

let $ = $props

this.specs = {
    name: 'Volume ',
    props: {
        colorVolUp: $.colorVolUp,
        colorVolDw: $.colorVolDw,
        barsHeight: $.barsHeight,
        showAvgVolume: $.showSMA,
        avgVolumeSMA: $.length,
        colorAvgVol: $.colorSMA
    },
    settings: {
        zIndex: $.zIndex
    }
}

[UPDATE]

let v = vol[0] !== undefined ? vol[0] : 0
let dir = close[0] >= open[0] ? 1 : -1

Volume([v, dir], this.specs)
