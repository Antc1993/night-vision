// Navy ~ 0.2-lite
// <ds>SuperBands (Reverse Volatility Bands)</ds>

[INDICATOR name=SuperBands, version=1.0.0]

prop('length', { type: 'integer', def: 20 })
prop('mult1', { type: 'number', def: 1.0 })
prop('mult2', { type: 'number', def: 2.0 })
prop('mult3', { type: 'number', def: 3.0 })
prop('color1', { type: 'color', def: '#d80d3848' })
prop('color1dark', { type: 'color', def: '#d80d3824' })
prop('color2', { type: 'color', def: '#1edbbe33' })
prop('color2dark', { type: 'color', def: '#1edbbe15' })
prop('prec', { type: 'integer', def: autoPrec() })
prop('zIndex', { type: 'integer', def: -1 })

this.specs = {
    name: `SuperBands ${$props.length}`,
    props: {
        color1: $props.color1,
        color1dark: $props.color1dark,
        color2: $props.color2,
        color2dark: $props.color2dark,
    },
    settings: {
        precision: $props.prec,
        zIndex: $props.zIndex
    }
}

[UPDATE]

let $ = $props
let b = sma(close, $.length)[0]
let dev = atr($.length)[0]

let high1 = b + dev * $.mult3
let mid1  = b + dev * $.mult2
let low1  = b + dev * $.mult1

let high2 = b - dev * $.mult1
let mid2  = b - dev * $.mult2
let low2  = b - dev * $.mult3

SuperBands([high1, mid1, low1, high2, mid2, low2], this.specs)
