// Navy ~ 0.2-lite

// <ds>Volume bars with delta ( = buyVol - sellVol)</ds>
// Format: [<timestamp>, <buyVol>, <sellVol>, <total>, <delta>]

[OVERLAY name=VolumeDelta, ctx=Canvas, version=1.2.0]

// Overlay props
prop('colorVolUp', { type: 'color', def: '#26a69a66' })
prop('colorVolDw', { type: 'color', def: '#ef535066' })
prop('colorVolDeltaUp', { type: 'color', def: '#26a69a' })
prop('colorVolDeltaDw', { type: 'color', def: '#ef5350' })
prop('barsHeight', { type: 'number', def: 0.85, step: 0.05 })
prop('currencySymbol', { type: 'string', def: '' })
prop('precision', { type: 'number', def: 2 })

// Draw call
draw(ctx) {
    const layout = $core.layout
    const data = $core.data
    const view = $core.view
    if (!data || !data.length || !view) return

    const config = $core.props.config
    const pxStep = layout.pxStep || 8
    const w = Math.max(Math.floor(pxStep * (config.CANDLEW || 0.75)), 1)
    const halfW = Math.floor(w / 2)
    const baseY = layout.height

    const paneOverlays = $core.hub?.panes()?.[$core.paneId]?.overlays || []
    const hasMainCandles = paneOverlays.some(o => o.main && o.type !== 'VolumeDelta')
    const isMainPane = hasMainCandles || ($core.paneId === $core.hub?.mainPaneId && paneOverlays.length > 1)

    // Determine max volume across view subset
    let maxV = 0
    for (let i = view.i1, n = view.i2; i <= n; i++) {
        let p = data[i]
        if (!p) continue
        let total = (p[3] !== undefined && !isNaN(p[3])) ? p[3] : ((p[1] || 0) + (p[2] || 0))
        if (total > maxV) maxV = total
    }
    if (maxV === 0) maxV = 1

    const scaleH = isMainPane ? (baseY * ($props.barsHeight || 0.15)) : (baseY * ($props.barsHeight || 0.85))

    let upVolBars = []
    let dwVolBars = []
    let upDeltaBars = []
    let dwDeltaBars = []

    for (let i = view.i1, n = view.i2; i <= n; i++) {
        let p = data[i]
        if (!p) continue

        let buyVol = p[1] || 0
        let sellVol = p[2] || 0
        let total = (p[3] !== undefined && !isNaN(p[3])) ? p[3] : (buyVol + sellVol)
        let delta = (p[4] !== undefined && !isNaN(p[4])) ? p[4] : (buyVol - sellVol)

        let x = layout.ti2x ? layout.ti2x(p[0], i) : layout.time2x(p[0])
        let totalH = Math.max(Math.round((total / maxV) * scaleH), 1)
        let deltaRatio = total > 0 ? (Math.min(Math.abs(delta), total) / total) : 0
        let deltaH = Math.max(Math.round(totalH * deltaRatio), 1)

        let isUp = delta >= 0
        let barX = x - halfW

        let totalBar = { x: barX, y: baseY - totalH, w: w, h: totalH }
        let deltaBar = { x: barX, y: baseY - deltaH, w: w, h: deltaH }

        if (isUp) {
            upVolBars.push(totalBar)
            upDeltaBars.push(deltaBar)
        } else {
            dwVolBars.push(totalBar)
            dwDeltaBars.push(deltaBar)
        }
    }

    // Draw total volume background bars
    drawBars(ctx, dwVolBars, $props.colorVolDw || '#ef535066')
    drawBars(ctx, upVolBars, $props.colorVolUp || '#26a69a66')

    // Draw solid delta overlay bars
    drawBars(ctx, dwDeltaBars, $props.colorVolDeltaDw || '#ef5350')
    drawBars(ctx, upDeltaBars, $props.colorVolDeltaUp || '#26a69a')
}

drawBars(ctx, bars, color) {
    if (!bars || !bars.length) return
    ctx.fillStyle = color
    ctx.beginPath()
    for (let i = 0, n = bars.length; i < n; i++) {
        let b = bars[i]
        ctx.rect(b.x, b.y, b.w, b.h)
    }
    ctx.fill()
}

// Custom y-range: used when VolumeDelta is in an offchart pane
static yRange(data) {
    if (!data || !data.length) return null
    let max = 0
    for (let i = 0; i < data.length; i++) {
        let p = data[i]
        if (!p) continue
        let total = (p[3] !== undefined && !isNaN(p[3])) ? p[3] : ((p[1] || 0) + (p[2] || 0))
        if (total > max) max = total
    }
    return [max * 1.15, 0]
}

// Precision detection
static preSampler(x) => [x && x[3] !== undefined ? Math.round(x[3] * 100) / 100 : 0]

// Legend, defined as formatted HTML string
legendHtml(x) {
    let v = $core.cursor.getValue($core.paneId, $core.id) || x || []
    let colorText = $core.colors.text || '#ffffff'
    let fc = $lib.formatCash || (n => (n !== undefined ? n.toFixed(2) : '0'))

    let buyVol = v[1] !== undefined ? v[1] : 0
    let sellVol = v[2] !== undefined ? v[2] : 0
    let total = v[3] !== undefined ? v[3] : (buyVol + sellVol)
    let delta = v[4] !== undefined ? v[4] : (buyVol - sellVol)

    let isUp = delta >= 0
    let deltaColor = isUp ? ($props.colorVolDeltaUp || '#26a69a') : ($props.colorVolDeltaDw || '#ef5350')
    let sign = delta > 0 ? '+' : ''

    return `
    <span style="color: ${deltaColor}; font-family: Inter, sans-serif;">
        <span style="color: ${colorText}; opacity: 0.7;">B:</span>
        <span class="nvjs-ll-value" style="color: ${$props.colorVolDeltaUp || '#26a69a'}; font-weight: 500;">${fc(buyVol)}</span>
        <span style="margin-left: 6px; color: ${colorText}; opacity: 0.7;">S:</span>
        <span class="nvjs-ll-value" style="color: ${$props.colorVolDeltaDw || '#ef5350'}; font-weight: 500;">${fc(sellVol)}</span>
        <span style="margin-left: 6px; color: ${colorText}; opacity: 0.7;">Σ:</span>
        <span class="nvjs-ll-value" style="color: ${colorText}; font-weight: 600;">${fc(total)}</span>
        <span style="margin-left: 6px; color: ${colorText}; opacity: 0.7;">Δ:</span>
        <span class="nvjs-ll-value" style="color: ${deltaColor}; font-weight: 600;">${sign}${fc(delta)}</span>
    </span>
    `
}
