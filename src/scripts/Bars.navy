
// NavyJS ~ 0.2-lite

// <ds>OHLC Bar Chart</ds>, format:
// [<timestamp>, <open>, <high>, <low>, <close>, <?volume>]

[OVERLAY name=Bars, ctx=Canvas, version=1.0.0]

prop('colorUp', { type: 'color', def: $core.colors.candleUp || '#26a69a' })
prop('colorDw', { type: 'color', def: $core.colors.candleDw || '#ef5350' })
prop('colorVolUp', { type: 'color', def: $core.colors.volUp || '#26a69a44' })
prop('colorVolDw', { type: 'color', def: $core.colors.volDw || '#ef535044' })
prop('showVolume', { type: 'boolean', def: true })
prop('lineWidth', { type: 'number', def: 1.5 })
prop('tickWidth', { type: 'number', def: 3.5 })
prop('currencySymbol', { type: 'string', def: '$' })
prop('priceLine', { type: 'boolean', def: true })
prop('showValueTracker', { type: 'boolean', def: true })

draw(ctx) {
    const layout = $core.layout
    const data = $core.data
    const view = $core.view

    if (!data || !data.length || !view) return

    const tickW = Math.max(Math.min((layout.spacex || 8) * 0.35, 6), 2)
    const lw = $props.lineWidth || 1.5

    ctx.lineWidth = lw

    // Draw bars
    for (let i = view.i1, n = view.i2; i <= n; i++) {
        const p = data[i]
        if (!p) continue

        const x = layout.ti2x(p[0], i)
        const yO = layout.value2y(p[1])
        const yH = layout.value2y(p[2])
        const yL = layout.value2y(p[3])
        const yC = layout.value2y(p[4])

        const isUp = p[4] >= p[1]
        ctx.strokeStyle = isUp ? $props.colorUp : $props.colorDw

        ctx.beginPath()
        // Vertical High to Low line
        ctx.moveTo(x, yH)
        ctx.lineTo(x, yL)

        // Left tick (Open)
        ctx.moveTo(x - tickW, yO)
        ctx.lineTo(x, yO)

        // Right tick (Close)
        ctx.moveTo(x, yC)
        ctx.lineTo(x + tickW, yC)

        ctx.stroke()
    }

    // Volume bars if enabled
    if ($props.showVolume) {
        let cnv = $lib.layoutCnv($core, true, true)
        let w = Math.max(cnv.upBodies?.[0]?.w || tickW * 2, 1)
        if (cnv.dwVolbars && cnv.upVolbars) {
            ctx.lineWidth = w
            ctx.strokeStyle = $props.colorVolDw
            ctx.beginPath()
            for (let i = 0; i < cnv.dwVolbars.length; i++) {
                $lib.volumeBar(ctx, cnv.dwVolbars[i], layout)
            }
            ctx.stroke()

            ctx.strokeStyle = $props.colorVolUp
            ctx.beginPath()
            for (let i = 0; i < cnv.upVolbars.length; i++) {
                $lib.volumeBar(ctx, cnv.upVolbars[i], layout)
            }
            ctx.stroke()
        }
    }
}

static yRange(data) {
    let len = data.length
    var high = -Infinity, low = Infinity
    for(let i = 0; i < len; i++) {
        let p = data[i]
        if (p[2] > high) high = p[2]
        if (p[3] < low) low = p[3]
    }
    return [high, low]
}

static preSampler(x) => [x[1], x[4]]

ohlc(x) => [x[1], x[2], x[3], x[4]]

valueTracker(x) => {
    show: $props.showValueTracker,
    line: $props.priceLine,
    color: (x[4] >= x[1]) ? $props.colorUp : $props.colorDw,
    value: x[4]
}

legendHtml(x, prec, f) {
    let color1 = $core.colors.text
    let color2 = x[4] >= x[1] ? $props.colorUp : $props.colorDw
    let sym = $props.currencySymbol || '$'
    let fc = $lib.formatCash
    return `
    <span style="color: ${color2}">
        <span style="margin-left: 3px;"></span>
        <span style="color: ${color1}">O</span>
        <span class="nvjs-ll-value">${f(x[1])}</span>
        <span style="color: ${color1}">H</span>
        <span class="nvjs-ll-value">${f(x[2])}</span>
        <span style="color: ${color1}">L</span>
        <span class="nvjs-ll-value">${f(x[3])}</span>
        <span style="color: ${color1}">C</span>
        <span class="nvjs-ll-value">${f(x[4])}</span>
    `
    + ($props.showVolume && x[5] !== undefined ? `
        <span style="color: ${color1}">V</span>
        <span class="nvjs-ll-value">${sym+fc(x[5])}</span>` : ``)
    + `</span>`
}
